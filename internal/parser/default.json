{
  "episode": [
    {
      "name": "S01E01-02",
      "pattern": "(?:^|[^a-z0-9])s(?<season>\\d{1,3})[ ._-]?e(?<episode>\\d{1,4})-(?<episodeEnd>\\d{1,4})(?:[^0-9p]|$)"
    },
    {
      "name": "S01E01",
      "pattern": "(?:^|[^a-z0-9])s(?<season>\\d{1,3})[ ._-]?e(?<episode>\\d{1,4})(?:[ ._]?-?[ ._]?e(?<episodeEnd>\\d{1,4}))?(?:[^0-9]|$)"
    },
    {
      "name": "1x01",
      "pattern": "(?:^|[^a-z0-9])(?<season>\\d{1,2})x(?<episode>\\d{2,3})(?:-(?:\\d{1,2}x)?(?<episodeEnd>\\d{2,3}))?(?:[^0-9]|$)"
    },
    {
      "name": "Season 1 Episode 1",
      "pattern": "season[ ._-]*(?<season>\\d{1,3})[ ._-]*(?:-[ ._-]*)?episode[ ._-]*(?<episode>\\d{1,4})"
    },
    {
      "name": "Episode 1",
      "pattern": "(?:^|[^a-z0-9])(?:episode|ep|e|part|pt)[ ._-]?(?<episode>\\d{1,4})(?:[^0-9]|$)"
    },
    {
      "name": "Show - 01",
      "pattern": "[ _]-[ _](?<episode>\\d{1,4})(?:v\\d)?(?:[ _.\\[(]|$)"
    },
    {
      "name": "01 Title",
      "pattern": "^(?<episode>\\d{1,3})(?:[ ._-]|$)"
    },
    {
      "name": "Title 01",
      "pattern": "[ ._-](?<episode>\\d{1,3})$"
    }
  ],
  "season": [
    {
      "name": "Season 1",
      "pattern": "(?:^|[^a-z0-9])(?:season|series)[ ._-]*(?<season>\\d{1,3})(?:[^0-9]|$)"
    },
    {
      "name": "S01",
      "pattern": "^s(?<season>\\d{1,3})$"
    },
    {
      "name": "Specials",
      "pattern": "^(?<specials>specials?)$"
    }
  ],
  "junk": [
    "(?:^|[^a-z0-9])(?:480|576|720|1080|1440|2160|4320)[pi](?:[^a-z0-9]|$)",
    "(?:^|[^a-z0-9])[xh][ .]?26[45](?:[^a-z0-9]|$)",
    "(?:^|[^a-z0-9])(?:hevc|avc|xvid|divx|av1|vp9|10bit|8bit|hdr10\\+?|hdr|dv|sdr|remux|bluray|blu-ray|bdrip|brrip|web-?dl|webrip|web|hdtv|dvdrip|amzn|nf|dsnp|hmax|atvp|proper|repack|internal|multi|dual|aac|ac3|eac3|ddp?|dts|truehd|atmos|flac|opus|mp3)(?:[^a-z0-9]|$)",
    "(?:^|[^a-z0-9])(?:dd|ddp|aac|dts)?\\d\\.\\d(?:[^0-9]|$)",
    "(?:^|[^0-9])(?:19|20)\\d{2}(?:[^0-9]|$)",
    "\\[[0-9a-f]{8}\\]"
  ]
}
