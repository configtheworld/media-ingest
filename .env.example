# --- Metadata ---------------------------------------------------------------
# TMDB API key (v3) or read access token (v4). If empty, an admin enters it once
# on the setup page; it is then stored in /data/tmdb_api_key with mode 0600.
TMDB_API_KEY=

# --- docker compose (host side) ------------------------------------------------
# Host folder holding your libraries (mounted at MEDIA_ROOT) and the app data.
# MEDIA_PATH=/mnt/media
# DATA_PATH=/opt/media-ingest/data
# Use 127.0.0.1:8097 to expose the app on this machine only.
# PUBLISH=8097

# --- Paths (inside the container) --------------------------------------------
MEDIA_ROOT=/media
# Relative to MEDIA_ROOT:
TV_DIR=tv
MOVIES_DIR=movies
# STAGING_DIR=.incoming
# TRASH_DIR=.trash

# --- Ownership and permissions of published files -----------------------------
# docker compose runs the container as PUID:PGID; published files get this owner.
# Use the uid/gid that owns your media folders (see "ls -ln" on the host).
PUID=1000
PGID=1000
# UMASK=022
# FILE_MODE=0644
# DIR_MODE=0755

# --- Authentication -----------------------------------------------------------
# proxy (default): trust AUTH_HEADER only from TRUSTED_PROXIES; fail closed otherwise.
AUTH_MODE=proxy
TRUSTED_PROXIES=192.0.2.10
# AUTH_HEADER=Remote-User
# AUTH_GROUPS_HEADER=Remote-Groups
# Who may use the setup page and settings. If neither is set, every signed-in user is admin.
# ADMIN_USERS=alice,bob
# ADMIN_GROUP=admins

# basic: built-in login. Generate the hash with:
#   docker run --rm -i media-ingest:local hash-password
# AUTH_MODE=basic
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH=$argon2id$v=19$m=65536,t=3,p=2$...

# none: no authentication at all. Requires explicit confirmation.
# AUTH_MODE=none
# AUTH_NONE_CONFIRM=true

# Set to false only for plain-HTTP testing without a TLS proxy.
# COOKIE_SECURE=true

# --- Limits -------------------------------------------------------------------
# MAX_UPLOAD_GB=200
# UPLOAD_EXPIRY_HOURS=72
# ALLOWED_EXTENSIONS=mkv,mp4,m4v,avi,mov,wmv,mpg,mpeg,ts,m2ts,webm,flv,vob,ogv,3gp,srt,ass,ssa,vtt,sub,idx,sup,smi

# --- Jellyfin (optional) ------------------------------------------------------
# After each batch the app calls POST /Library/Media/Updated with the new paths
# (falling back to POST /Library/Refresh). Failures never affect publishing.
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
# MEDIA_ROOT as Jellyfin sees it, if its mount differs (default: MEDIA_ROOT).
# JELLYFIN_PATH_PREFIX=/data/media

# --- Trash ---------------------------------------------------------------------
# Undo and "replace" move files to <MEDIA_ROOT>/.trash. Entries older than this
# many days are deleted; 0 keeps them forever.
# TRASH_RETENTION_DAYS=30

# --- Misc ---------------------------------------------------------------------
# LISTEN_ADDR=:8097
# LOG_LEVEL=info
